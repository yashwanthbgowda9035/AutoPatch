{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AutoPatch: Debug FastAPI (local)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8015"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "AUTOPATCH_PUBLIC_DEMO": "0",
        "AUTOPATCH_ALLOWED_HOSTS": "localhost,127.0.0.1,testserver"
      }
    }
  ]
}
